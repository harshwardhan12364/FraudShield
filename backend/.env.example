# Environment Configuration for FraudShield 360
# Copy this file to .env and fill in values. NEVER commit .env to Git.

# App
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
APP_FRONTEND_ORIGIN=http://localhost:5173
APP_DEBUG=true

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./fraudshield.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/fraudshield

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,txt,csv

# Blockchain
# Set BLOCKCHAIN_ENV to LOCAL_DEVELOPMENT or MST_TESTNET
BLOCKCHAIN_ENV=LOCAL_DEVELOPMENT
# LOCAL_DEVELOPMENT: Hardhat node default
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_CHAIN_ID=31337
# MST_TESTNET (only after verifying official MST docs):
# MST_RPC_URL=
# MST_CHAIN_ID=
# DEPLOYER_PRIVATE_KEY=  ← NEVER COMMIT
CONTRACT_ADDRESS=

# Rate Limiting
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_REPORT=10/minute

# Admin bootstrap (used only for first-run seeding, disable after)
BOOTSTRAP_ADMIN_EMAIL=admin@fraudshield.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
